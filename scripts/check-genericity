#!/usr/bin/env bash
set -euo pipefail

# Missing host utilities must fail closed, including inside conditional grep calls below.
command -v dirname >/dev/null
command -v grep >/dev/null

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if grep -RniE 'Sylvara|Torrek|Milo|Cassian|Eirenhold|Veyrath|Asterra' crates/; then
  echo 'Campaign-specific current-campaign terms are forbidden in production Rust crates.' >&2
  exit 1
fi

echo 'Genericity guard passed.'

#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# A launcher on PATH (notably the Windows Store alias) is not proof of a usable Python.
probe='import sys, tomllib; assert sys.version_info >= (3, 11)'
if [[ -n "${PYTHON:-}" ]]; then
  interpreter="$PYTHON"
  if ! "$interpreter" -c "$probe" >/dev/null 2>&1; then
    echo 'Architecture guard requires PYTHON to name a working Python 3.11+ executable.' >&2
    exit 1
  fi
else
  interpreter=''
  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null && "$candidate" -c "$probe" >/dev/null 2>&1; then
      interpreter="$candidate"
      break
    fi
  done
  if [[ -z "$interpreter" ]]; then
    echo 'Architecture guard requires Python 3.11+. Install it or set PYTHON to its executable.' >&2
    exit 1
  fi
fi

"$interpreter" -B -m unittest discover -s "$repo_root/scripts/tests" -p test_check_boundaries.py -q
"$interpreter" -B "$repo_root/scripts/check_boundaries.py" "$repo_root"

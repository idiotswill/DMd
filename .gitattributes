# Manifest integrity is calculated over bytes, independent of checkout platform.
/content/** text eol=lf
# Tauri's CLI rewrites this manifest with LF during release builds.
/crates/dmd-desktop/Cargo.toml text eol=lf
/third-party-notices/** text eol=lf
# Genuine saved-history exports retain original bytes, including CRLF terminators.
/crates/dmd-app/tests/fixtures/reactions-v1-*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
